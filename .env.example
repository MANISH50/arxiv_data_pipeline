# arXiv API: no key or account needed (export.arxiv.org). Nothing to configure for it.

# Azure SQL Database (free tier)
# Create at: https://aka.ms/azuresqlhub -> "Try for free"
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=PatentIntelligence
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=

# Azure DevOps Boards (ticket workflow)
# Create at: https://dev.azure.com -> New Organization/Project
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_EMAIL=you@example.com

# NOTE: The AZURE_SQL_* variables must also be configured as Application Settings
# in the Azure Function App for the daily sync automation.
# See: CLAUDE.md for deployment instructions.
